<?xml version="1.0" encoding="utf-8"?>
<!--
  Network Security Configuration for CRM Mobile Native (Phase E1 follow-up).

  Policy:
    - Cleartext (HTTP) globally blocked.
    - Localhost + emulator loopback (10.0.2.2) allowed cleartext for
      Metro bundler + local backend during development only.
    - Production API domain uses strict TLS AND certificate pinning
      via <pin-set>. The pin set below MUST be populated with real
      SPKI SHA-256 fingerprints before a production build ships —
      see docs/ssl-pinning.md for the exact openssl command and
      rollout procedure.

  Rollout invariant: always keep AT LEAST TWO pins in the set at any
  time — the current leaf cert's key plus a backup. When rotating,
  publish the next cert's pin as the backup in a new app release,
  wait for adoption, then switch. This prevents a rotated cert from
  bricking the app between releases.
-->
<network-security-config>
    <!-- Block cleartext traffic globally -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Allow cleartext for localhost only (React Native Metro bundler in dev) -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>

    <!--
      Production + staging API domains — certificate pinning ACTIVE.

      Prod crm.allcheckservices.com moved behind AWS ALB + ACM on 2026-07-04
      (ADR-0087); its cert now chains  Amazon leaf ← Amazon RSA 2048 M04 ←
      Amazon Root CA 1. Staging (staging.crm.allcheckservices.com, covered by
      includeSubdomains) stays on Let's Encrypt ← ISRG Root X1.

      Strategy — pin the durable ROOTS, not the leaves. Android matches the pin
      set against the VERIFIED chain incl. the system trust anchor, so pinning
      the root keeps the app reachable across ACM/LE leaf + intermediate
      rotation WITHOUT a new release. This REPLACES the pre-AWS LE-leaf pin,
      which the 2026-07-04 ACM cutover silently invalidated (neither the LE
      leaf nor ISRG X1 match an Amazon chain) — bricking every prod APK's TLS
      handshake until this fix.

      Verified against live prod + staging on 2026-07-05:
        prod    leaf D66I0OanuKa9eNTBNdHOZUZ+sA4AHbLd4nhjARvcns8= ← Amazon Root CA 1
        staging leaf M/QuFeWttkucvDYCIUIzrWlRhm5S/s3yuR33hMo8FfY= ← ISRG Root X1

      Rotation invariant: keep at least TWO pins. Re-validate before 2028-12-31.
      Release guard: scripts/check-ssl-pins.sh is a FORMAT check only — it does
      NOT verify a live match, which is why the stale pin shipped (see follow-up).
    -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">crm.allcheckservices.com</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
        <pin-set expiration="2028-12-31">
            <!-- Prod: Amazon Root CA 1 (AWS ACM anchor, valid to 2038) -->
            <pin digest="SHA-256">++MBgDH5WGvL9Bcn5Be30cRcL0f5O+NyoXuWtQdX1aI=</pin>
            <!-- Staging: ISRG Root X1 (Let's Encrypt anchor, valid to 2035) -->
            <pin digest="SHA-256">C5+lpZ7tcVwmwQIMcRtPbsQtWLABXhQzejna0wHFr8M=</pin>
        </pin-set>
    </domain-config>
</network-security-config>

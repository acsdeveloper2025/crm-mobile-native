<?xml version="1.0" encoding="utf-8"?>
<!--
  Network Security Configuration for CRM Mobile Native (Phase E1 follow-up).

  Policy:
    - Cleartext (HTTP) globally blocked.
    - Localhost + emulator loopback (10.0.2.2) allowed cleartext for
      Metro bundler + local backend during development only.
    - Production API domain uses strict TLS AND certificate pinning
      via <pin-set>. The pin set below MUST be populated with real
      SPKI SHA-256 fingerprints before a production build ships —
      see docs/ssl-pinning.md for the exact openssl command and
      rollout procedure.

  Rollout invariant: always keep AT LEAST TWO pins in the set at any
  time — the current leaf cert's key plus a backup. When rotating,
  publish the next cert's pin as the backup in a new app release,
  wait for adoption, then switch. This prevents a rotated cert from
  bricking the app between releases.
-->
<network-security-config>
    <!-- Block cleartext traffic globally -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Allow cleartext for localhost only (React Native Metro bundler in dev) -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>

    <!--
      Production API domain — certificate pinning ACTIVE (2026-04-19).

      Pin set (refreshed 2026-06-18 for the /api/v2 connection):
        Primary: SPKI SHA-256 of the current leaf cert for
                 crm.allcheckservices.com (Let's Encrypt leaf, rotates every
                 ~60 days).
        Backup : SPKI SHA-256 of the ISRG Root X1 trust anchor (valid to
                 2035). Android matches the pin set against the VERIFIED chain
                 incl. the trust anchor, so when the LE leaf/intermediate
                 rotate the root pin keeps the app reachable WITHOUT a new
                 release — the durable strategy for a sideloaded field APK.

      Expiration: 2028-12-31 — pins reviewed/re-validated before this date.
      Because the backup pins the long-lived ISRG root, leaf rotation no
      longer bricks the app between releases.

      Verified against live server on 2026-06-18: leaf SPKI
      V329rvVf6FFkAnHhuxgqMXVCR9puyLSJbeXYMGVllIc= (issuer LE YR2 ← ISRG X1).

      Release pipeline guard: scripts/check-ssl-pins.sh fails the build if
      the pin-set element is missing, placeholder values leak through, or
      pin values are not 44-char base64 SHA-256 digests.
    -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">crm.allcheckservices.com</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
        <pin-set expiration="2028-12-31">
            <!-- Primary: crm.allcheckservices.com leaf cert (Let's Encrypt, refreshed 2026-06-18) -->
            <pin digest="SHA-256">V329rvVf6FFkAnHhuxgqMXVCR9puyLSJbeXYMGVllIc=</pin>
            <!-- Backup: ISRG Root X1 trust anchor (durable; survives LE leaf/intermediate rotation) -->
            <pin digest="SHA-256">C5+lpZ7tcVwmwQIMcRtPbsQtWLABXhQzejna0wHFr8M=</pin>
        </pin-set>
    </domain-config>
</network-security-config>

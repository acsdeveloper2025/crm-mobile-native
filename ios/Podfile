# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'CrmMobileNative' do
  # 2026-05-18: Firebase Swift pods (FirebaseCoreInternal) require modular
  # headers to be importable when building as static libraries. Without
  # this, pod install fails with "Swift pods cannot yet be integrated as
  # static libraries". Targeted modular_headers per the failing pod so the
  # rest of the project keeps its non-modular default.
  pod 'GoogleUtilities', :modular_headers => true

  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Bump every Pod target's iOS deployment target to match the app (15.1).
    # Silences Xcode 26.5 warnings for sub-pods (e.g. PromisesObjC=9.0,
    # react-native-blob-util=11.0) that ship outdated minimums.
    #
    # ALSO: bulk-silence cosmetic warning categories on vendored Pod code.
    # The app target stays strict; these flags only apply inside Pods/.
    # Each category was reviewed individually and either patched (real bugs)
    # or accepted (cosmetic / unfixable in vendored code).
    pod_warning_suppressions = %w[
      -Wno-nullability-completeness
      -Wno-documentation-deprecated-sync
      -Wno-reorder-init-list
      -Wno-objc-missing-super-calls
      -Wno-deprecated-declarations
      -Wno-unused-function
      -Wno-shorten-64-to-32
      -Wno-unused-variable
      -Wno-vla-cxx-extension
      -Wno-incomplete-implementation
      -Wno-documentation
      -Wno-unneeded-internal-declaration
      -Wno-objc-property-synthesis
      -Wno-objc-autosynthesis-property-ivar-name-match
      -Wno-ambiguous-macro
      -Wno-comma
      -Wno-strict-prototypes
      -Wno-enum-enum-conversion
      -Wno-unused-value
      -Wno-unreachable-code
      -Wno-objc-protocol-method-implementation
      -Wno-#warnings
    ]
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        current = config.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
        if current && current.to_f < 15.1
          config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.1'
        end
        existing = Array(config.build_settings['WARNING_CFLAGS'] || ['$(inherited)'])
        config.build_settings['WARNING_CFLAGS'] = (existing + pod_warning_suppressions).uniq

        # Silence all Swift warnings inside Pod targets (vendored Swift code).
        # The app's own Swift code stays strict.
        existing_swift = Array(config.build_settings['OTHER_SWIFT_FLAGS'] || ['$(inherited)'])
        unless existing_swift.include?('-suppress-warnings')
          config.build_settings['OTHER_SWIFT_FLAGS'] = existing_swift + ['-suppress-warnings']
        end
      end
    end

    # Mark the RNFB Core Configuration script phase as alwaysOutOfDate so
    # Xcode stops warning that it has no outputs. CocoaPods regenerates
    # this phase on every pod install, so reapply the flag here.
    app_project = Xcodeproj::Project.open(File.expand_path('CrmMobileNative.xcodeproj', __dir__))
    app_project.targets.each do |target|
      next unless target.name == 'CrmMobileNative'
      target.shell_script_build_phases.each do |phase|
        if phase.name && phase.name.include?('[RNFB] Core Configuration')
          phase.always_out_of_date = '1'
        end
      end
    end
    app_project.save

    # Same treatment for the hermes-engine Pod's "Replace Hermes" script
    # phase — has no outputs by design (replaces the prebuilt framework).
    installer.pods_project.targets.each do |target|
      next unless target.name == 'hermes-engine'
      target.shell_script_build_phases.each do |phase|
        if phase.name && phase.name.include?('Replace Hermes')
          phase.always_out_of_date = '1'
        end
      end
    end
    installer.pods_project.save
  end
end

	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<!--
		  T0-9 (audit 2026-05-17): iOS SPKI pinning via Apple-native
		  NSPinnedDomains (iOS 14+; deployment target is 15.1).
		  Mirrors android/app/src/main/res/xml/network_security_config.xml
		  pin-set. Both pins verified against the live cert on 2026-05-18.

		  Pins (refreshed 2026-06-18 for the /api/v2 connection):
		    Primary: SPKI SHA-256 of crm.allcheckservices.com leaf cert
		             (Let's Encrypt; rotates every ~60 days).
		    Backup : SPKI SHA-256 of the ISRG Root X1 trust anchor
		             (valid to 2035). NSPinnedCAIdentities pins a CA in
		             the verified chain, so the LE leaf/intermediate can
		             rotate WITHOUT a new release — durable strategy.

		  Rotation invariant: keep at least TWO pins at all times. With
		  the ISRG-root backup, leaf rotation no longer bricks the app.
		  See docs/ssl-pinning.md.

		  Re-validate before review date 2028-12-31.
		-->
		<key>NSPinnedDomains</key>
		<dict>
			<key>crm.allcheckservices.com</key>
			<dict>
				<key>NSIncludesSubdomains</key>
				<true/>
				<key>NSPinnedCAIdentities</key>
				<array>
					<dict>
						<!-- Primary: crm.allcheckservices.com leaf cert (Let's Encrypt, refreshed 2026-06-18) -->
						<key>SPKI-SHA256-BASE64</key>
						<string>V329rvVf6FFkAnHhuxgqMXVCR9puyLSJbeXYMGVllIc=</string>
					</dict>
					<dict>
						<!-- Backup: ISRG Root X1 trust anchor (durable; survives LE leaf/intermediate rotation) -->
						<key>SPKI-SHA256-BASE64</key>
						<string>C5+lpZ7tcVwmwQIMcRtPbsQtWLABXhQzejna0wHFr8M=</string>
					</dict>
				</array>
			</dict>
		</dict>
	</dict>

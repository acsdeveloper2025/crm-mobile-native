		<key>NSAllowsLocalNetworking</key>
		<true/>
		<!--
		  T0-9 (audit 2026-05-17): iOS SPKI pinning via Apple-native
		  NSPinnedDomains (iOS 14+; deployment target is 15.1).
		  Mirrors android/app/src/main/res/xml/network_security_config.xml
		  pin-set. Both pins verified against the live cert on 2026-05-18.

		  Pins:
		    Primary: SPKI SHA-256 of crm.allcheckservices.com leaf cert
		             (Let's Encrypt; rotates every ~60 days — refresh
		             with the next renewal).
		    Backup : SPKI SHA-256 of Let's Encrypt R13 intermediate CA
		             (rotates rarely — survives leaf renewals).

		  Rotation invariant: keep at least TWO pins at all times.
		  When the leaf rotates, add the next-cert pin as a THIRD pin
		  BEFORE the cert switch, wait for adoption, then drop the
		  old leaf pin. See docs/ssl-pinning.md.

		  Re-validate before pin-set expiration 2026-12-31.
		-->
		<key>NSPinnedDomains</key>
		<dict>
			<key>crm.allcheckservices.com</key>
			<dict>
				<key>NSIncludesSubdomains</key>
				<true/>
				<key>NSPinnedCAIdentities</key>
				<array>
					<dict>
						<key>SPKI-SHA256-BASE64</key>
						<string>+D94EBRU5pr3Lcn2SvqWT8E+MSR6oDpQx952sp+iH2M=</string>
					</dict>
					<dict>
						<key>SPKI-SHA256-BASE64</key>
						<string>AlSQhgtJirc8ahLyekmtX+Iw+v46yPYRLJt9Cq1GlB0=</string>
					</dict>
				</array>
			</dict>
		</dict>
	</dict>

	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<!--
		  T0-9 (audit 2026-05-17): iOS SPKI pinning via Apple-native
		  NSPinnedDomains (iOS 14+; deployment target is 15.1).
		  Mirrors android/app/src/main/res/xml/network_security_config.xml
		  pin-set. Prod is behind AWS ALB + ACM since 2026-07-04 (ADR-0087).

		  Pins (ROOT-pinned 2026-07-05 after the AWS ACM cutover):
		    Prod   : Amazon Root CA 1 (AWS ACM anchor, valid
		             to 2038; survives ACM leaf rotation).
		    Staging: ISRG Root X1 (Let's Encrypt anchor, valid
		             to 2035). NSPinnedCAIdentities pins a CA in
		             the verified chain, so the verified chain, so the ROOT pin survives leaf
		             rotation WITHOUT a new release (pre-AWS leaf pin bricked prod 2026-07-04).

		  Rotation invariant: keep at least TWO pins at all times. With
		  the ISRG-root backup, leaf rotation no longer bricks the app.
		  See docs/ssl-pinning.md.

		  Re-validate before review date 2028-12-31.
		-->
		<key>NSPinnedDomains</key>
		<dict>
			<key>crm.allcheckservices.com</key>
			<dict>
				<key>NSIncludesSubdomains</key>
				<true/>
				<key>NSPinnedCAIdentities</key>
				<array>
					<dict>
						<!-- Prod: Amazon Root CA 1 (AWS ACM anchor, valid to 2038) -->
						<key>SPKI-SHA256-BASE64</key>
						<string>++MBgDH5WGvL9Bcn5Be30cRcL0f5O+NyoXuWtQdX1aI=</string>
					</dict>
					<dict>
						<!-- Staging: ISRG Root X2 (valid to 2035). 2026-07-17 — mirrors
						     the Android pin-set. Let's Encrypt issues staging's leaf as
						     leaf <- YE1 <- ISRG Root YE <- ISRG Root X2 (cross-signed by
						     X1). A device that trusts X2 ends the chain THERE and never
						     sees X1, so pinning X1 alone rejects the connection; a device
						     that doesn't trust X2 follows the cross-sign to X1 and works.
						     X2 is in both paths — pin it, not the cross-signer above it.
						     v1.0.82 shipped with X1 only and failed on a real phone. -->
						<key>SPKI-SHA256-BASE64</key>
						<string>diGVwiVYbubAI3RW4hB9xU8e/CH2GnkuvVFZE8zmgzI=</string>
					</dict>
					<dict>
						<!-- Staging fallback: ISRG Root X1 (valid to 2035) — the
						     cross-signer above X2, only in the chain on devices that do
						     not trust X2. Keeps the two-pin rotation invariant. -->
						<key>SPKI-SHA256-BASE64</key>
						<string>C5+lpZ7tcVwmwQIMcRtPbsQtWLABXhQzejna0wHFr8M=</string>
					</dict>
				</array>
			</dict>
		</dict>
	</dict>
